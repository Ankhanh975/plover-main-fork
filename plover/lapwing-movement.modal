{
    "exclude_entry": false,
    "exit_on_mismatch": true,
    "exit_on_match": false,
    "ignore_folding": true,

    "entry": {
        "STPH": "{&}",
        "#TPH": "{&}"
    },

    "dict": {
        "KPA": "{-|}",
        "S": "{&s}",
        "STK": "{&z}",
        "STKPW": "{&z}",
        "SK": "{&e}",
        "SKW": "{&i}",
        "SKWR": "{&j}",
        "SR": "{&v}",
        "T": "{&t}",
        "TK": "{&d}",
        "TKPW": "{&g}",
        "TP": "{&f}",
        "TPH": "{&n}",
        "TH": "{&th}",
        "K": "{&k}",
        "KP": "{&x}",
        "KW": "{&q}",
        "KWH": "{&y}",
        "KR": "{&c}",
        "P": "{&p}",
        "PW": "{&b}",
        "PH": "{&m}",
        "W": "{&w}",
        "WH": "{&wh}",
        "WR": "{&u}",
        "H": "{&h}",
        "HR": "{&l}",
        "R": "{&r}",
        "A": "{&a}",
        "O": "{&o}",
        "E": "{&e}",
        "EU": "{&i}",
        "U": "{&u}",

        "S-R": "{&S}",
        "STK-R": "{&Z}",
        "STKPW-R": "{&Z}",
        "SK-R": "{&E}",
        "SKW-R": "{&I}",
        "SKWR-R": "{&J}",
        "SR-R": "{&V}",
        "T-R": "{&T}",
        "TK-R": "{&D}",
        "TKPW-R": "{&G}",
        "TP-R": "{&F}",
        "TPH-R": "{&N}",
        "TH-R": "{&TH}",
        "K-R": "{&K}",
        "KP-R": "{&X}",
        "KW-R": "{&Q}",
        "KWH-R": "{&Y}",
        "KR-R": "{&C}",
        "P-R": "{&P}",
        "PW-R": "{&B}",
        "PH-R": "{&M}",
        "W-R": "{&W}",
        "WH-R": "{&WH}",
        "WR-R": "{&U}",
        "H-R": "{&H}",
        "HR-R": "{&L}",
        "R-R": "{&R}",
        "A-R": "{&A}",
        "O-R": "{&O}",
        "E-R": "{&E}",
        "EU-R": "{&I}",
        "U-R": "{&U}",

        "*FR": "{#Shift_l(Home)}{^}",
        "*FBL": "{#Shift_l(Page_Down)}{^}",
        "*R": "{#Shift_l(Left)}{^}",
        "*RPG": "{#Shift_l(Page_Up)}{^}",
        "*RB": "{#Control_L(Shift_l(Left))}{^}",
        "*P": "{#Shift_l(Up)}{^}",
        "*B": "{#Shift_l(Down)}{^}",
        "*BG": "{#Control_L(Shift_l(Right))}{^}",
        "*LG": "{#Shift_l(End)}{^}",
        "*G": "{#Shift_l(Right)}{^}",
        "-FR": "{#Home}{^}",
        "-FPL": "{#Control_l(Home)}{^}",
        "-FBL": "{#Page_Down}{^}",
        "-R": "{#Left}{^}",
        "-RPG": "{#Page_Up}{^}",
        "-RB": "{#Control_L(Left)}{^}",
        "-RBG": "{#Control_l(End)}",
        "-RBT": "{#Control_L(Left)}{#Control_L(Left)}{#Control_L(Left)}{^}",
        "-RBTS": "{#Control_L(Left)}{#Control_L(Left)}{#Control_L(Left)}{#Control_L(Left)}{^}",
        "-RBS": "{#Control_L(Left)}{#Control_L(Left)}{^}",
        "-RT": "{#Left}{^}{#Left}{^}{#Left}{^}",
        "-RTS": "{#Left}{^}{#Left}{^}{#Left}{^}{#Left}{^}",
        "-RS": "{#Left}{^}{#Left}{^}",
        "-P": "{#Up}{^}",
        "-PT": "{#Up}{^}{#Up}{^}{#Up}{^}",
        "-PTS": "{#Up}{^}{#Up}{^}{#Up}{^}{#Up}{^}",
        "-PS": "{#Up}{^}{#Up}{^}",
        "-B": "{#Down}{^}",
        "-BG": "{#Control_L(Right)}{^}",
        "-BGT": "{#Control_L(Right)}{#Control_L(Right)}{#Control_L(Right)}{^}",
        "-BGTS": "{#Control_L(Right)}{#Control_L(Right)}{#Control_L(Right)}{#Control_L(Right)}{^}",
        "-BGS": "{#Control_L(Right)}{#Control_L(Right)}{^}",
        "-BT": "{#Down}{^}{#Down}{^}{#Down}{^}",
        "-BTS": "{#Down}{^}{#Down}{^}{#Down}{^}{#Down}{^}",
        "-BS": "{#Down}{^}{#Down}{^}",
        "-LG": "{#End}{^}",
        "-G": "{#Right}{^}",
        "-GT": "{#Right}{^}{#Right}{^}{#Right}{^}",
        "-GTS": "{#Right}{^}{#Right}{^}{#Right}{^}{#Right}{^}",
        "-GS": "{#Right}{^}{#Right}{^}"
    }
}
