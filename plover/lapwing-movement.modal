{
    "exclude_entry": false,
    "exit_on_mismatch": false,
    "exit_on_match": false,
    "ignore_folding": false,

    "entry": {
        "SKWR": "{&}{^}",
        "-N": "{&}{^}"
    },

    "exit": {
        "-X": "{&}{^}",
        "STPH": "{&}{^}",
        "#TPH": "{&}{^}"
    },
    

    "dict": {
        "*": "=undo",
        "SP": "{^ ^}",
        "KPA": "{-|}",

        "S": "{&s}{^}",
        "STK": "{&z}{^}",
        "STKPW": "{&z}{^}",
        "SK": "{&e}{^}",
        "SKW": "{&i}{^}",
        "SKWR": "{&j}{^}",
        "SR": "{&v}{^}",
        "T": "{&t}{^}",
        "TK": "{&d}{^}",
        "TKPW": "{&g}{^}",
        "TP": "{&f}{^}",
        "TPH": "{&n}{^}",
        "TH": "{&th}{^}",
        "K": "{&k}{^}",
        "KP": "{&x}{^}",
        "KW": "{&q}{^}",
        "KWH": "{&y}{^}",
        "KR": "{&c}{^}",
        "P": "{&p}{^}",
        "PW": "{&b}{^}",
        "PH": "{&m}{^}",
        "W": "{&w}{^}",
        "WH": "{&wh}{^}",
        "WR": "{&u}{^}",
        "H": "{&h}{^}",
        "HR": "{&l}{^}",
        "R": "{&r}{^}",
        "A": "{&a}{^}",
        "O": "{&o}{^}",
        "E": "{&e}{^}",
        "EU": "{&i}{^}",
        "U": "{&u}{^}",

        "S*": "{&S}{^}",
        "STK*": "{&Z}{^}",
        "STKPW*": "{&Z}{^}",
        "SK*": "{&E}{^}",
        "SKW*": "{&I}{^}",
        "SKWR*": "{&J}{^}",
        "SR*": "{&V}{^}",
        "T*": "{&T}{^}",
        "TK*": "{&D}{^}",
        "TKPW*": "{&G}{^}",
        "TP*": "{&F}{^}",
        "TPH*": "{&N}{^}",
        "TH*": "{&TH}{^}",
        "K*": "{&K}{^}",
        "KP*": "{&X}{^}",
        "KW*": "{&Q}{^}",
        "KWH*": "{&Y}{^}",
        "KR*": "{&C}{^}",
        "P*": "{&P}{^}",
        "PW*": "{&B}{^}",
        "PH*": "{&M}{^}",
        "W*": "{&W}{^}",
        "WH*": "{&WH}{^}",
        "WR*": "{&U}{^}",
        "H*": "{&H}{^}",
        "HR*": "{&L}{^}",
        "R*": "{&R}{^}",
        "*A": "{&A}{^}",
        "*O": "{&O}{^}",
        "*E": "{&E}{^}",
        "*EU": "{&I}{^}",
        "*U": "{&U}{^}",

        "S-R": "{#Control_L(s)}",
        "STK-R": "{#Control_L(z)}",
        "STKPW-R": "{#Control_L(z)}",
        "SK-R": "{#Control_L(e)}",
        "SKW-R": "{#Control_L(i)}",
        "SKWR-R": "{#Control_L(j)}",
        "SR-R": "{#Control_L(v)}",
        "T-R": "{#Control_L(t)}",
        "TK-R": "{#Control_L(d)}",
        "TKPW-R": "{#Control_L(g)}",
        "TP-R": "{#Control_L(f)}",
        "TPH-R": "{#Control_L(n)}",
        "K-R": "{#Control_L(k)}",
        "KP-R": "{#Control_L(x)}",
        "KW-R": "{#Control_L(q)}",
        "KWH-R": "{#Control_L(y)}",
        "KR-R": "{#Control_L(c)}",
        "P-R": "{#Control_L(p)}",
        "PW-R": "{#Control_L(b)}",
        "PH-R": "{#Control_L(m)}",
        "W-R": "{#Control_L(w)}",
        "WR-R": "{#Control_L(u)}",
        "H-R": "{#Control_L(h)}",
        "HR-R": "{#Control_L(l)}",
        "R-R": "{#Control_L(r)}",
        "AR": "{#Control_L(a)}",
        "OR": "{#Control_L(o)}",
        "ER": "{#Control_L(e)}",
        "EUR": "{#Control_L(i)}",
        "UR": "{#Control_L(u)}",

        "S-FP": "{#Shift_L(s)}",
        "STK-FP": "{#Shift_L(z)}",
        "STKPW-FP": "{#Shift_L(z)}",
        "SK-FP": "{#Shift_L(e)}",
        "SKW-FP": "{#Shift_L(i)}",
        "SKWR-FP": "{#Shift_L(j)}",
        "SR-FP": "{#Shift_L(v)}",
        "T-FP": "{#Shift_L(t)}",
        "TK-FP": "{#Shift_L(d)}",
        "TKPW-FP": "{#Shift_L(g)}",
        "TP-FP": "{#Shift_L(f)}",
        "TPH-FP": "{#Shift_L(n)}",
        "K-FP": "{#Shift_L(k)}",
        "KP-FP": "{#Shift_L(x)}",
        "KW-FP": "{#Shift_L(q)}",
        "KWH-FP": "{#Shift_L(y)}",
        "KR-FP": "{#Shift_L(c)}",
        "P-FP": "{#Shift_L(p)}",
        "PW-FP": "{#Shift_L(b)}",
        "PH-FP": "{#Shift_L(m)}",
        "W-FP": "{#Shift_L(w)}",
        "WR-FP": "{#Shift_L(u)}",
        "H-FP": "{#Shift_L(h)}",
        "HR-FP": "{#Shift_L(l)}",
        "R-FP": "{#Shift_L(r)}",
        "AFP": "{#Shift_L(a)}",
        "OFP": "{#Shift_L(o)}",
        "EFP": "{#Shift_L(e)}",
        "EUFP": "{#Shift_L(i)}",
        "UFP": "{#Shift_L(u)}",


        "S-FRP": "{#Control_L(Shift_L(s))}",
        "STK-FRP": "{#Control_L(Shift_L(z))}",
        "STKPW-FRP": "{#Control_L(Shift_L(z))}",
        "SK-FRP": "{#Control_L(Shift_L(e))}",
        "SKW-FRP": "{#Control_L(Shift_L(i))}",
        "SKWR-FRP": "{#Control_L(Shift_L(j))}",
        "SR-FRP": "{#Control_L(Shift_L(v))}",
        "T-FRP": "{#Control_L(Shift_L(t))}",
        "TK-FRP": "{#Control_L(Shift_L(d))}",
        "TKPW-FRP": "{#Control_L(Shift_L(g))}",
        "TP-FRP": "{#Control_L(Shift_L(f))}",
        "TPH-FRP": "{#Control_L(Shift_L(n))}",
        "K-FRP": "{#Control_L(Shift_L(k))}",
        "KP-FRP": "{#Control_L(Shift_L(x))}",
        "KW-FRP": "{#Control_L(Shift_L(q))}",
        "KWH-FRP": "{#Control_L(Shift_L(y))}",
        "KR-FRP": "{#Control_L(Shift_L(c))}",
        "P-FRP": "{#Control_L(Shift_L(p))}",
        "PW-FRP": "{#Control_L(Shift_L(b))}",
        "PH-FRP": "{#Control_L(Shift_L(m))}",
        "W-FRP": "{#Control_L(Shift_L(w))}",
        "WR-FRP": "{#Control_L(Shift_L(u))}",
        "H-FRP": "{#Control_L(Shift_L(h))}",
        "HR-FRP": "{#Control_L(Shift_L(l))}",
        "R-FRP": "{#Control_L(Shift_L(r))}",
        "AFRP": "{#Control_L(Shift_L(a))}",
        "OFRP": "{#Control_L(Shift_L(o))}",
        "EFRP": "{#Control_L(Shift_L(e))}",
        "EUFRP": "{#Control_L(Shift_L(i))}",
        "UFRP": "{#Control_L(Shift_L(u))}",

        "-Z": "{#Return}",
        "-BT": "{#Tab}",
        "-S": "{#Escape}"
    }
}
