{
    "exclude_entry": false,
    "exit_on_mismatch": false,
    "exit_on_match": false,
    "ignore_folding": false,

    "entry": {
        "SKWR": "{&}{^}",
        "-N": "{&}{^}"
    },
    
    "exit": {
        "-X": "{&}{^}",
        "STPH": "{&}{^}",
        "#TPH": "{&}{^}",

        "SKWR": "{^ ^}",
        "TP-PL": "{.}",
        "KPA": "{:case:cap_first_word}",
        "KW-BG": "{,}",
        "R-R": "{^ ^}"
    },
    
    "dict": {
        "*": "=undo",
        "SP": "{^ ^}",

        "S": "{&s}{^}",
        "STK": "{&z}{^}",
        "STKPW": "{&z}{^}",
        "SK": "{&e}{^}",
        "SKW": "{&i}{^}",
        "SKWR": "{&j}{^}",
        "SR": "{&v}{^}",
        "T": "{&t}{^}",
        "TK": "{&d}{^}",
        "TKPW": "{&g}{^}",
        "TP": "{&f}{^}",
        "TPH": "{&n}{^}",
        "TH": "{&th}{^}",
        "K": "{&k}{^}",
        "KP": "{&x}{^}",
        "KW": "{&q}{^}",
        "KWH": "{&y}{^}",
        "KR": "{&c}{^}",
        "P": "{&p}{^}",
        "PW": "{&b}{^}",
        "PH": "{&m}{^}",
        "W": "{&w}{^}",
        "WH": "{&wh}{^}",
        "WR": "{&u}{^}",
        "H": "{&h}{^}",
        "HR": "{&l}{^}",
        "R": "{&r}{^}",
        "A": "{&a}{^}",
        "O": "{&o}{^}",
        "E": "{&e}{^}",
        "EU": "{&i}{^}",
        "U": "{&u}{^}",

        "S*": "{&S}{^}",
        "STK*": "{&Z}{^}",
        "STKPW*": "{&Z}{^}",
        "SK*": "{&E}{^}",
        "SKW*": "{&I}{^}",
        "SKWR*": "{&J}{^}",
        "SR*": "{&V}{^}",
        "T*": "{&T}{^}",
        "TK*": "{&D}{^}",
        "TKPW*": "{&G}{^}",
        "TP*": "{&F}{^}",
        "TPH*": "{&N}{^}",
        "TH*": "{&TH}{^}",
        "K*": "{&K}{^}",
        "KP*": "{&X}{^}",
        "KW*": "{&Q}{^}",
        "KWH*": "{&Y}{^}",
        "KR*": "{&C}{^}",
        "P*": "{&P}{^}",
        "PW*": "{&B}{^}",
        "PH*": "{&M}{^}",
        "W*": "{&W}{^}",
        "WH*": "{&WH}{^}",
        "WR*": "{&U}{^}",
        "H*": "{&H}{^}",
        "HR*": "{&L}{^}",
        "R*": "{&R}{^}",
        "*A": "{&A}{^}",
        "*O": "{&O}{^}",
        "*E": "{&E}{^}",
        "*EU": "{&I}{^}",
        "*U": "{&U}{^}"
    }
}
