{
    "exclude_entry": false,
    "exit_on_mismatch": false,
    "exit_on_match": false,
    "ignore_folding": false,

    "entry": {
        "SKWR": "{&}{^}",
        "-N": "{&}{^}"
    },

    "exit": {
        "-X": "{&}{^}",
        "STPH": "{&}{^}",
        "#TPH": "{&}{^}",

        "SKWR": "{^ ^}",
        "TP-PL": "{.}",
        "KPA": "{:case:cap_first_word}",
        "KW-BG": "{,}"

    },
    

    "dict": {
        "*": "=undo",
        "SP": "{^ ^}",

        "S": "{&s}{^}",
        "STK": "{&z}{^}",
        "STKPW": "{&z}{^}",
        "SK": "{&e}{^}",
        "SKW": "{&i}{^}",
